# Em produção as variáveis vêm da Vercel (Project Settings > Environment Variables).
# Para rodar localmente com os mesmos valores:  vercel env pull .env.local
# Ou copie este arquivo para ".env.local" e preencha (Supabase > Project Settings > API).
# NUNCA coloque a service_role key aqui: o build é interrompido se ela aparecer.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
